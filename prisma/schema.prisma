generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id        String    @id @default(uuid())
  email     String
  name      String?
  avatarUrl String?   @map("avatar_url")
  locale    String    @default("pt-BR")
  roleId    String?  @map("role_id")
  tenantId  String   @map("tenant_id")
  removedAt DateTime? @map("removed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  role   Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  tenant Workspace @relation(fields: [tenantId], references: [id])

  teamMemberAreas           TeamMemberArea[]
  createdTeamAreas          TeamArea[]                        @relation("TeamAreaCreator")
  createdProjects           Project[]                         @relation("ProjectCreator")
  taskAssignments           TaskAssignee[]                    @relation("AssignedTasks")
  createdTasks              Task[]                            @relation("TaskCreator")
  comments                  Comment[]
  createdDocuments          Document[]
  calendarAuth              CalendarAuth?
  calendarOAuthAttempts     CalendarOAuthAttempt[]
  calendarEvents            CalendarEvent[]
  calendarEventAttendees    CalendarEventAttendee[]
  activities                Activity[]                        @relation("ActivityActor")
  notifications             Notification[]
  commentMentions           CommentMention[]
  savedViews                SavedView[]
  pushSubscriptions         PushSubscription[]
  ownedContracts            Contract[]                        @relation("ContractOwner")
  contractChangeActors      ContractChange[]                  @relation("ContractChangeActor")
  contractAudits            ContractAudit[]                   @relation("ContractAuditActor")
  proposalTemplates         ProposalTemplate[]                @relation("ProposalTemplateCreator")
  proposals                 Proposal[]                        @relation("ProposalCreator")
  aiProviderConnections     AiProviderConnection[]            @relation("AiProviderConnectionCreator")
  aiConnectionAudits        AiProviderConnectionAudit[]       @relation("AiProviderConnectionAuditActor")
  editedDirectives          WorkspaceDirective[]              @relation("WorkspaceDirectiveEditor")
  aiStudioUsageEvents       AiStudioUsageEvent[]              @relation("AiStudioUsageEventActor")
  aiStudioConsents          AiStudioConsent[]                 @relation("AiStudioConsentActor")
  aiCreditLedgerEntries     AiCreditLedgerEntry[]             @relation("AiCreditLedgerActor")
  aiStudioManagedCycles     AiStudioManagedCycle[]            @relation("AiStudioManagedCycleActor")
  aiCreditLimit             AiMemberCreditLimit?
  projectMembers            ProjectMember[]
  closedBetaOwnedEnrollment ClosedBetaEnrollment?             @relation("ClosedBetaOwner")
  checkinResponses          ClosedBetaCheckinResponse[]
  checkinCompletions        ClosedBetaCheckinWorkspaceState[] @relation("ClosedBetaCheckinCompleter")
  aiCreditPurchases         AiCreditPurchase[]

  @@index([tenantId])
  @@map("profiles")
}

model Role {
  id          String   @id @default(uuid())
  name        String
  permissions Json     @default("[]")
  isAdmin     Boolean  @default(false) @map("is_admin")
  tenantId    String   @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant     Workspace   @relation("RoleTenant", fields: [tenantId], references: [id])
  profiles   Profile[]
  workspaces Workspace[]
  invites    Invite[]

  @@unique([name, tenantId])
  @@index([isAdmin])
  @@index([tenantId])
  @@map("roles")
}

model Workspace {
  id                   String    @id @default(uuid())
  name                 String
  slug              String    @unique
  logoUrl           String?   @map("logo_url")
  companyName       String?   @map("company_name")
  defaultRoleId     String?   @map("default_role_id")
  stripeCustomerId  String?   @map("stripe_customer_id")
  pixKey               String?   @map("pix_key")
  bindingCodeHash      String?   @map("binding_code_hash")
  bindingCodeUpdatedAt DateTime? @map("binding_code_updated_at")
  planId            String?   @map("plan_id")
  status               String    @default("active")
  gracePeriodEndsAt DateTime? @map("grace_period_ends_at")
  cancelledAt       DateTime? @map("cancelled_at")
  deletedAt         DateTime? @map("deleted_at")
  onboardingCompleted  Boolean   @default(false) @map("onboarding_completed")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  defaultRole Role? @relation(fields: [defaultRoleId], references: [id], onDelete: SetNull)
  plan        Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  profiles Profile[]
  roles    Role[]    @relation("RoleTenant")

  teamAreas              TeamArea[]
  teamMemberAreas        TeamMemberArea[]
  projects               Project[]
  projectColumns         ProjectColumn[]
  tasks                  Task[]
  taskAssignees          TaskAssignee[]
  comments               Comment[]
  commentMentions        CommentMention[]
  documents              Document[]
  calendarAuths          CalendarAuth[]
  calendarOAuthAttempts  CalendarOAuthAttempt[]
  calendarEvents         CalendarEvent[]
  calendarEventAttendees CalendarEventAttendee[]
  activities             Activity[]
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  savedViews             SavedView[]
  clients                Client[]
  contracts              Contract[]
  contractItems          ContractItem[]
  contractProjects       ContractProject[]
  installments           Installment[]
  contractChanges        ContractChange[]
  contractAudits         ContractAudit[]
  proposalTemplates      ProposalTemplate[]
  proposals              Proposal[]
  proposalItems          ProposalItem[]
  aiProviderConnections  AiProviderConnection[]
  aiConnectionAudits     AiProviderConnectionAudit[]
  directive              WorkspaceDirective?
  aiStudioUsageEvents    AiStudioUsageEvent[]
  aiStudioConsents       AiStudioConsent[]
  aiCreditLedgerEntries  AiCreditLedgerEntry[]
  aiStudioManagedCycles  AiStudioManagedCycle[]
  aiCreditLimits         AiMemberCreditLimit[]
  invites                Invite[]
  readOnlyAccesses       ReadOnlyAccess[]
  closedBetaEnrollment   ClosedBetaEnrollment?
  closedBetaInvitations  ClosedBetaInvitation[]
  checkinResponses       ClosedBetaCheckinResponse[]
  checkinWorkspaceStates ClosedBetaCheckinWorkspaceState[]
  aiCreditPurchases     AiCreditPurchase[]

  @@map("workspaces")
}

model Invite {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  email       String
  roleId      String?   @map("role_id")
  token       String    @unique
  status      String    @default("pending")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role      Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([email])
  @@index([email, status, expiresAt])
  @@map("invites")
}

model WorkspaceBindingAttempt {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  attemptCount    Int       @default(0) @map("attempt_count")
  windowStartedAt DateTime  @map("window_started_at")
  blockedUntil    DateTime? @map("blocked_until")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("workspace_binding_attempts")
}

model ReadOnlyAccess {
  id          String    @id @default(uuid())
  token       String    @unique
  workspaceId String    @map("workspace_id")
  email       String
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  usedAt      DateTime? @map("used_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("read_only_accesses")
}

model Plan {
  id                     String   @id @default(uuid())
  name                   String
  stripePriceId  String?  @map("stripe_price_id")
  allowedModules Json     @default("[]")
  monthlyAiStudioCredits Int?    @map("monthly_ai_studio_credits")
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  isInternal     Boolean  @default(false) @map("is_internal")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  workspaces       Workspace[]
  planLimits PlanLimit[]
  closedBetaConfig ClosedBetaConfig?

  @@map("plans")
}

model PlanLimit {
  id        String   @id @default(uuid())
  planId    String   @map("plan_id")
  resource  String
  limit     Int
  behavior  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("plan_limits")
}

model AiCreditLedgerEntry {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  actorId       String?   @map("actor_id")
  pool          String
  kind          String
  quantity      Int
  operationKey  String    @map("operation_key")
  sourceId      String?   @map("source_id")
  billingPeriod String?   @map("billing_period")
  reason        String?
  metadata      Json      @default("{}")
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  Profile?  @relation("AiCreditLedgerActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([tenantId, operationKey, pool])
  @@index([tenantId, createdAt])
  @@index([tenantId, pool, expiresAt])
  @@map("ai_credit_ledger_entries")
}

model AiCreditPackage {
  id                  String   @id @default(uuid())
  name                String
  stripePriceId       String   @unique @map("stripe_price_id")
  priceCents          Int      @map("price_cents")
  creditQuantity      Int      @map("credit_quantity")
  maxPurchasesPerMonth Int?    @map("max_purchases_per_month")
  maxCreditsPerMonth  Int?     @map("max_credits_per_month")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  purchases AiCreditPurchase[]

  @@index([isActive])
  @@map("ai_credit_packages")
}

model AiCreditPurchase {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  purchaserId          String   @map("purchaser_id")
  packageId            String   @map("package_id")
  stripeCheckoutSessionId String @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId String?  @unique @map("stripe_payment_intent_id")
  amountCents          Int      @map("amount_cents")
  creditQuantity       Int      @map("credit_quantity")
  refundedAmountCents  Int      @default(0) @map("refunded_amount_cents")
  status               String   @default("pending")
  createdAt            DateTime @default(now()) @map("created_at")
  paidAt               DateTime? @map("paid_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant    Workspace      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaser Profile        @relation(fields: [purchaserId], references: [id], onDelete: Restrict)
  package   AiCreditPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
  @@map("ai_credit_purchases")
}

model AiMemberCreditLimit {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  profileId    String   @unique @map("profile_id")
  monthlyLimit Int      @map("monthly_limit")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant  Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([tenantId, profileId])
  @@index([tenantId])
  @@map("ai_member_credit_limits")
}

model AiModelCatalogEntry {
  id                 String    @id @default(uuid())
  provider           String
  model              String
  ownershipMode      String    @map("ownership_mode")
  isActive           Boolean   @default(true) @map("is_active")
  vision             Boolean   @default(false)
  streaming          Boolean   @default(false)
  inputCostMicros    Int       @map("input_cost_micros")
  outputCostMicros   Int       @map("output_cost_micros")
  imageCostMicros    Int       @default(0) @map("image_cost_micros")
  creditCostPerCycle Int       @map("credit_cost_per_cycle")
  maxOutputTokens    Int       @map("max_output_tokens")
  version            Int       @default(1)
  effectiveFrom      DateTime  @default(now()) @map("effective_from")
  effectiveTo        DateTime? @map("effective_to")
  createdBy          String    @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([provider, model, version])
  @@index([provider, model, isActive])
  @@index([effectiveFrom, effectiveTo])
  @@map("ai_model_catalog_entries")
}

model AiStudioManagedCycle {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  actorId              String   @map("actor_id")
  provider             String
  model                String
  catalogEntryId       String   @map("catalog_entry_id")
  modelVersion         Int      @map("model_version")
  inputCostMicros      Int      @map("input_cost_micros")
  outputCostMicros     Int      @map("output_cost_micros")
  imageCostMicros      Int      @map("image_cost_micros")
  creditCostPerCycle   Int      @map("credit_cost_per_cycle")
  debitOperationKey    String   @unique @map("debit_operation_key")
  status               String   @default("active")
  alterationCount      Int      @default(0) @map("alteration_count")
  refundedFailureCount Int      @default(0) @map("refunded_failure_count")
  expiresAt            DateTime @map("expires_at")
  lastCandidateHtml    String?  @map("last_candidate_html")
  detectedVariables    Json     @default("[]") @map("detected_variables")
  sessionSummary       Json?    @map("session_summary")
  switchHistory         Json     @default("[]") @map("switch_history")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  Profile   @relation("AiStudioManagedCycleActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId, actorId, status, expiresAt])
  @@index([tenantId, createdAt])
  @@map("ai_studio_managed_cycles")
}

model ClosedBetaConfig {
  id                    String   @id @default("default")
  status                String   @default("paused")
  maxPrimaryWorkspaces  Int      @default(30) @map("max_primary_workspaces")
  maxGuestsPerWorkspace Int      @default(3) @map("max_guests_per_workspace")
  planId                String   @unique @map("plan_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("closed_beta_configs")
}

model ClosedBetaEnrollment {
  id             String    @id @default(uuid())
  workspaceId    String    @unique @map("workspace_id")
  ownerProfileId String    @unique @map("owner_profile_id")
  status         String    @default("active")
  source         String    @default("invitation")
  previousPlanId String?   @map("previous_plan_id")
  consentVersion String?   @map("consent_version")
  consentedAt    DateTime? @map("consented_at")
  joinedAt       DateTime  @default(now()) @map("joined_at")
  leftAt         DateTime? @map("left_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     Profile   @relation("ClosedBetaOwner", fields: [ownerProfileId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([ownerProfileId])
  @@map("closed_beta_enrollments")
}

model ClosedBetaInvitation {
  id              String    @id @default(uuid())
  email           String
  tokenHash       String    @unique @map("token_hash")
  status          String    @default("pending")
  expiresAt       DateTime  @map("expires_at")
  reservedAt      DateTime  @default(now()) @map("reserved_at")
  acceptedAt      DateTime? @map("accepted_at")
  revokedAt       DateTime? @map("revoked_at")
  workspaceId     String?   @map("workspace_id")
  createdByUserId String    @map("created_by_user_id")
  createdByEmail  String    @map("created_by_email")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([status, expiresAt])
  @@index([workspaceId])
  @@map("closed_beta_invitations")
}

model ClosedBetaAuditEvent {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  actorEmail  String?  @map("actor_email")
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  beforeValue Json?    @map("before_value")
  afterValue  Json?    @map("after_value")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([actorUserId, createdAt])
  @@map("closed_beta_audit_events")
}

model ClosedBetaRateLimit {
  key             String    @id
  attemptCount    Int       @default(0) @map("attempt_count")
  windowStartedAt DateTime  @map("window_started_at")
  blockedUntil    DateTime? @map("blocked_until")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([blockedUntil])
  @@map("closed_beta_rate_limits")
}

model ClosedBetaCheckinEdition {
  id          String    @id @default(uuid())
  title       String
  status      String    @default("draft")
  isMandatory Boolean   @default(true) @map("is_mandatory")
  opensAt     DateTime? @map("opens_at")
  closesAt    DateTime? @map("closes_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  questions       ClosedBetaCheckinQuestion[]
  responses       ClosedBetaCheckinResponse[]
  workspaceStates ClosedBetaCheckinWorkspaceState[]

  @@map("closed_beta_checkin_editions")
}

model ClosedBetaCheckinQuestion {
  id                   String   @id @default(uuid())
  editionId            String   @map("edition_id")
  text                 String
  type                 String
  options              Json?
  required             Boolean  @default(true)
  position             Int      @default(0)
  theme                String?
  isSuggestionQuestion Boolean  @default(false) @map("is_suggestion_question")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  edition ClosedBetaCheckinEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId])
  @@map("closed_beta_checkin_questions")
}

model ClosedBetaQuestionBank {
  id                   String   @id @default(uuid())
  text                 String
  type                 String
  options              Json?
  required             Boolean  @default(true)
  theme                String?
  isSuggestionQuestion Boolean  @default(false) @map("is_suggestion_question")
  status               String   @default("active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([theme])
  @@map("closed_beta_question_bank")
}

model ClosedBetaCheckinResponse {
  id          String   @id @default(uuid())
  editionId   String   @map("edition_id")
  workspaceId String   @map("workspace_id")
  profileId   String   @map("profile_id")
  answers     Json
  isPrimary   Boolean  @default(false) @map("is_primary")
  isCurrent   Boolean  @default(true) @map("is_current")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  edition   ClosedBetaCheckinEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  workspace Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   Profile                  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([editionId, profileId])
  @@index([editionId, workspaceId])
  @@index([workspaceId])
  @@index([profileId])
  @@map("closed_beta_checkin_responses")
}

model ClosedBetaCheckinWorkspaceState {
  id                   String    @id @default(uuid())
  editionId            String    @map("edition_id")
  workspaceId          String    @map("workspace_id")
  status               String    @default("pending")
  completedByProfileId String?   @map("completed_by_profile_id")
  completedAt          DateTime? @map("completed_at")
  exemptionReason      String?   @map("exemption_reason")
  exemptionExpiresAt   DateTime? @map("exemption_expires_at")
  grantedByUserId      String?   @map("granted_by_user_id")
  grantedByEmail       String?   @map("granted_by_email")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  edition     ClosedBetaCheckinEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  completedBy Profile?                 @relation("ClosedBetaCheckinCompleter", fields: [completedByProfileId], references: [id], onDelete: SetNull)

  @@unique([editionId, workspaceId])
  @@index([workspaceId])
  @@index([status])
  @@map("closed_beta_checkin_workspace_states")
}

model TeamArea {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   @default("#3b82f6")
  createdBy String   @map("created_by")
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator        Profile          @relation("TeamAreaCreator", fields: [createdBy], references: [id])
  tenant         Workspace        @relation(fields: [tenantId], references: [id])
  memberAreas    TeamMemberArea[]
  projects       Project[]
  tasks          Task[]
  calendarEvents CalendarEvent[]

  @@index([tenantId])
  @@map("team_areas")
}

model TeamMemberArea {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  areaId   String @map("area_id")
  tenantId String @map("tenant_id")

  user   Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  area   TeamArea  @relation(fields: [areaId], references: [id], onDelete: Cascade)
  tenant Workspace @relation(fields: [tenantId], references: [id])

  @@unique([userId, areaId])
  @@index([tenantId])
  @@map("team_member_areas")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  areaId      String?  @map("area_id")
  createdBy   String   @map("created_by")
  tenantId    String   @map("tenant_id")
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  area             TeamArea?         @relation(fields: [areaId], references: [id])
  creator          Profile           @relation("ProjectCreator", fields: [createdBy], references: [id])
  tenant           Workspace         @relation(fields: [tenantId], references: [id])
  columns          ProjectColumn[]
  tasks            Task[]
  documents        Document[]
  contractProjects ContractProject[]
  projectMembers   ProjectMember[]

  @@index([areaId])
  @@index([tenantId])
  @@map("projects")
}

model ProjectMember {
  projectId          String   @map("project_id")
  profileId          String   @map("profile_id")
  autoAssignedByArea Boolean  @default(false) @map("auto_assigned_by_area")
  joinedAt           DateTime @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([projectId, profileId])
  @@index([profileId])
  @@map("project_members")
}

model ProjectColumn {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  name           String
  position       Int
  color          String?
  completesTasks Boolean  @default(false) @map("completes_tasks")
  tenantId       String   @map("tenant_id")
