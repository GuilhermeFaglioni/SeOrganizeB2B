generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id        String   @id @default(uuid())
  email     String
  name      String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teamMemberAreas        TeamMemberArea[]
  createdTeamAreas       TeamArea[]              @relation("TeamAreaCreator")
  createdProjects        Project[]               @relation("ProjectCreator")
  taskAssignments        TaskAssignee[]          @relation("AssignedTasks")
  createdTasks           Task[]                  @relation("TaskCreator")
  comments               Comment[]
  createdDocuments       Document[]
  calendarAuth           CalendarAuth?
  calendarEvents         CalendarEvent[]
  calendarEventAttendees CalendarEventAttendee[]
  activities             Activity[]              @relation("ActivityActor")
  notifications          Notification[]
  commentMentions        CommentMention[]
  savedViews             SavedView[]

  @@map("profiles")
}

model TeamArea {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   @default("#3b82f6")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator        Profile          @relation("TeamAreaCreator", fields: [createdBy], references: [id])
  memberAreas    TeamMemberArea[]
  projects       Project[]
  tasks          Task[]
  calendarEvents CalendarEvent[]

  @@map("team_areas")
}

model TeamMemberArea {
  id     String @id @default(uuid())
  userId String @map("user_id")
  areaId String @map("area_id")

  user Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  area TeamArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([userId, areaId])
  @@map("team_member_areas")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  areaId      String?  @map("area_id")
  createdBy   String   @map("created_by")
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  area      TeamArea?       @relation(fields: [areaId], references: [id])
  creator   Profile         @relation("ProjectCreator", fields: [createdBy], references: [id])
  columns   ProjectColumn[]
  tasks     Task[]
  documents Document[]

  @@index([areaId])
  @@map("projects")
}

model ProjectColumn {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  name           String
  position       Int
  color          String?
  completesTasks Boolean  @default(false) @map("completes_tasks")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("project_columns")
}

model Task {
  id                    String    @id @default(uuid())
  projectId             String    @map("project_id")
  columnId              String    @map("column_id")
  title                 String
  description           String?
  areaId                String?   @map("area_id")
  priority              String    @default("medium")
  dueDate               DateTime? @map("due_date")
  position              Float     @default(0)
  createdBy             String    @map("created_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  archived              Boolean   @default(false)
  archivedAt            DateTime? @map("archived_at")
  recurrenceType        String?   @map("recurrence_type")
  recurrenceInterval    Int?      @map("recurrence_interval")
  recurrenceSeriesId    String?   @map("recurrence_series_id")
  recurrenceGeneratedAt DateTime? @map("recurrence_generated_at")

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column         ProjectColumn   @relation(fields: [columnId], references: [id], onDelete: Restrict)
  area           TeamArea?       @relation(fields: [areaId], references: [id])
  creator        Profile         @relation("TaskCreator", fields: [createdBy], references: [id])
  assignees      TaskAssignee[]
  comments       Comment[]
  calendarEvents CalendarEvent[]
  activities     Activity[]

  @@index([projectId])
  @@index([columnId])
  @@index([areaId])
  @@index([dueDate])
  @@index([projectId, columnId, position])
  @@map("tasks")
}

model TaskAssignee {
  taskId     String   @map("task_id")
  profileId  String   @map("profile_id")
  assignedBy String   @map("assigned_by")
  assignedAt DateTime @default(now()) @map("assigned_at")

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  profile Profile @relation("AssignedTasks", fields: [profileId], references: [id], onDelete: Cascade)

  @@id([taskId, profileId])
  @@index([profileId])
  @@map("task_assignees")
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  authorId  String   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  task     Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author   Profile          @relation(fields: [authorId], references: [id])
  mentions CommentMention[]

  @@index([taskId])
  @@map("comments")
}

model Activity {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  taskId     String?  @map("task_id")
  type       String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor         Profile?       @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([actorId, createdAt])
  @@index([taskId, createdAt])
  @@index([entityType, entityId])
  @@map("activities")
}

model Notification {
  id          String    @id @default(uuid())
  recipientId String    @map("recipient_id")
  activityId  String    @map("activity_id")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  recipient Profile  @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  activity  Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([recipientId, activityId])
  @@index([recipientId, readAt, createdAt])
  @@map("notifications")
}

model CommentMention {
  commentId String   @map("comment_id")
  profileId String   @map("profile_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([commentId, profileId])
  @@index([profileId])
  @@map("comment_mentions")
}

model SavedView {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  scope     String
  filters   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, name])
  @@index([userId, scope])
  @@map("saved_views")
}

model Document {
  id        String   @id @default(uuid())
  title     String
  content   String   @default("")
  projectId String?  @map("project_id")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project? @relation(fields: [projectId], references: [id])
  creator Profile  @relation(fields: [createdBy], references: [id])

  @@index([projectId])
  @@index([createdBy])
  @@map("documents")
}

model CalendarAuth {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  googleEmail  String?  @map("google_email")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_auth")
}

model CalendarEvent {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  taskId      String?  @map("task_id")
  areaId      String?  @map("area_id")
  googleId    String?  @map("google_id")
  title       String
  description String?
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  allDay      Boolean  @default(false) @map("all_day")
  timeZone    String?  @map("time_zone")
  color       String?
  source      String   @default("google")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      Profile                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?                   @relation(fields: [taskId], references: [id])
  area      TeamArea?               @relation(fields: [areaId], references: [id], onDelete: SetNull)
  attendees CalendarEventAttendee[]

  @@index([userId, startTime])
  @@index([taskId])
  @@index([areaId])
  @@map("calendar_events")
}

model CalendarEventAttendee {
  id             String   @id @default(uuid())
  eventId        String   @map("event_id")
  profileId      String?  @map("profile_id")
  email          String
  displayName    String?  @map("display_name")
  responseStatus String   @default("needsAction") @map("response_status")
  organizer      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  profile Profile?      @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@unique([eventId, email])
  @@index([profileId])
  @@map("calendar_event_attendees")
}
