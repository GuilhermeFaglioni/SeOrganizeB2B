generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id        String   @id @default(uuid())
  email     String
  name      String?
  avatarUrl String?  @map("avatar_url")
  locale    String   @default("pt-BR")
  roleId    String?  @map("role_id")
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role   Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  tenant Workspace @relation(fields: [tenantId], references: [id])

  teamMemberAreas        TeamMemberArea[]
  createdTeamAreas       TeamArea[]              @relation("TeamAreaCreator")
  createdProjects        Project[]               @relation("ProjectCreator")
  taskAssignments        TaskAssignee[]          @relation("AssignedTasks")
  createdTasks           Task[]                  @relation("TaskCreator")
  comments               Comment[]
  createdDocuments       Document[]
  calendarAuth           CalendarAuth?
  calendarEvents         CalendarEvent[]
  calendarEventAttendees CalendarEventAttendee[]
  activities             Activity[]              @relation("ActivityActor")
  notifications          Notification[]
  commentMentions        CommentMention[]
  savedViews             SavedView[]
  pushSubscriptions      PushSubscription[]
  ownedContracts         Contract[]              @relation("ContractOwner")
  contractChangeActors   ContractChange[]        @relation("ContractChangeActor")
  contractAudits         ContractAudit[]         @relation("ContractAuditActor")
  proposalTemplates      ProposalTemplate[]      @relation("ProposalTemplateCreator")
  proposals              Proposal[]              @relation("ProposalCreator")

  @@index([tenantId])
  @@map("profiles")
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  permissions Json      @default("[]")
  isAdmin     Boolean   @default(false) @map("is_admin")
  tenantId    String?   @map("tenant_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant     Workspace? @relation("RoleTenant", fields: [tenantId], references: [id], onDelete: SetNull)
  profiles   Profile[]
  defaultFor WorkspaceSettings[]
  workspaces Workspace[]

  @@index([isAdmin])
  @@index([tenantId])
  @@map("roles")
}

model Workspace {
  id                String    @id @default(uuid())
  name              String
  slug              String    @unique
  logoUrl           String?   @map("logo_url")
  companyName       String?   @map("company_name")
  defaultRoleId     String?   @map("default_role_id")
  stripeCustomerId  String?   @map("stripe_customer_id")
  planId            String?   @map("plan_id")
  status            String    @default("active")
  gracePeriodEndsAt DateTime? @map("grace_period_ends_at")
  cancelledAt       DateTime? @map("cancelled_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  defaultRole Role? @relation(fields: [defaultRoleId], references: [id], onDelete: SetNull)
  plan        Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  profiles Profile[]
  roles    Role[]      @relation("RoleTenant")

  teamAreas             TeamArea[]
  teamMemberAreas       TeamMemberArea[]
  projects              Project[]
  projectColumns        ProjectColumn[]
  tasks                 Task[]
  taskAssignees         TaskAssignee[]
  comments              Comment[]
  commentMentions       CommentMention[]
  documents             Document[]
  calendarAuths         CalendarAuth[]
  calendarEvents        CalendarEvent[]
  calendarEventAttendees CalendarEventAttendee[]
  activities            Activity[]
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  savedViews            SavedView[]
  clients               Client[]
  contracts             Contract[]
  contractItems         ContractItem[]
  contractProjects      ContractProject[]
  installments          Installment[]
  contractChanges       ContractChange[]
  contractAudits        ContractAudit[]
  proposalTemplates     ProposalTemplate[]
  proposals             Proposal[]
  proposalItems         ProposalItem[]

  @@map("workspaces")
}

model Plan {
  id             String   @id @default(uuid())
  name           String
  stripePriceId  String?  @map("stripe_price_id")
  allowedModules Json     @default("[]")
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  workspaces Workspace[]
  planLimits PlanLimit[]

  @@map("plans")
}

model PlanLimit {
  id        String   @id @default(uuid())
  planId    String   @map("plan_id")
  resource  String
  limit     Int
  behavior  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("plan_limits")
}

model TeamArea {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   @default("#3b82f6")
  createdBy String   @map("created_by")
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator        Profile          @relation("TeamAreaCreator", fields: [createdBy], references: [id])
  tenant         Workspace        @relation(fields: [tenantId], references: [id])
  memberAreas    TeamMemberArea[]
  projects       Project[]
  tasks          Task[]
  calendarEvents CalendarEvent[]

  @@index([tenantId])
  @@map("team_areas")
}

model TeamMemberArea {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  areaId   String @map("area_id")
  tenantId String @map("tenant_id")

  user   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  area   TeamArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
  tenant Workspace @relation(fields: [tenantId], references: [id])

  @@unique([userId, areaId])
  @@index([tenantId])
  @@map("team_member_areas")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  areaId      String?  @map("area_id")
  createdBy   String   @map("created_by")
  tenantId    String   @map("tenant_id")
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  area             TeamArea?         @relation(fields: [areaId], references: [id])
  creator          Profile           @relation("ProjectCreator", fields: [createdBy], references: [id])
  tenant           Workspace         @relation(fields: [tenantId], references: [id])
  columns          ProjectColumn[]
  tasks            Task[]
  documents        Document[]
  contractProjects ContractProject[]

  @@index([areaId])
  @@index([tenantId])
  @@map("projects")
}

model ProjectColumn {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  name           String
  position       Int
  color          String?
  completesTasks Boolean  @default(false) @map("completes_tasks")
  tenantId       String   @map("tenant_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant  Workspace @relation(fields: [tenantId], references: [id])
  tasks   Task[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([tenantId])
  @@map("project_columns")
}

model Task {
  id                    String    @id @default(uuid())
  projectId             String    @map("project_id")
  columnId              String    @map("column_id")
  title                 String
  description           String?
  areaId                String?   @map("area_id")
  priority              String    @default("medium")
  dueDate               DateTime? @map("due_date")
  position              Float     @default(0)
  createdBy             String    @map("created_by")
  tenantId              String    @map("tenant_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  archived              Boolean   @default(false)
  archivedAt            DateTime? @map("archived_at")
  recurrenceType        String?   @map("recurrence_type")
  recurrenceInterval    Int?      @map("recurrence_interval")
  recurrenceSeriesId    String?   @map("recurrence_series_id")
  recurrenceGeneratedAt DateTime? @map("recurrence_generated_at")

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column         ProjectColumn   @relation(fields: [columnId], references: [id], onDelete: Restrict)
  area           TeamArea?       @relation(fields: [areaId], references: [id])
  creator        Profile         @relation("TaskCreator", fields: [createdBy], references: [id])
  tenant         Workspace       @relation(fields: [tenantId], references: [id])
  assignees      TaskAssignee[]
  comments       Comment[]
  calendarEvents CalendarEvent[]
  activities     Activity[]

  @@index([projectId])
  @@index([columnId])
  @@index([areaId])
  @@index([dueDate])
  @@index([projectId, columnId, position])
  @@index([tenantId])
  @@map("tasks")
}

model TaskAssignee {
  taskId     String   @map("task_id")
  profileId  String   @map("profile_id")
  assignedBy String   @map("assigned_by")
  tenantId   String   @map("tenant_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  task    Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  profile Profile    @relation("AssignedTasks", fields: [profileId], references: [id], onDelete: Cascade)
  tenant  Workspace  @relation(fields: [tenantId], references: [id])

  @@id([taskId, profileId])
  @@index([profileId])
  @@index([tenantId])
  @@map("task_assignees")
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  authorId  String   @map("author_id")
  content   String
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  task     Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author   Profile          @relation(fields: [authorId], references: [id])
  tenant   Workspace        @relation(fields: [tenantId], references: [id])
  mentions CommentMention[]

  @@index([taskId])
  @@index([tenantId])
  @@map("comments")
}

model Activity {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  taskId     String?  @map("task_id")
  type       String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  summary    String
  metadata   Json?
  tenantId   String   @map("tenant_id")
  createdAt  DateTime @default(now()) @map("created_at")

  actor         Profile?       @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  tenant        Workspace      @relation(fields: [tenantId], references: [id])
  notifications Notification[]

  @@index([actorId, createdAt])
  @@index([taskId, createdAt])
  @@index([entityType, entityId])
  @@index([tenantId])
  @@map("activities")
}

model Notification {
  id          String    @id @default(uuid())
  recipientId String    @map("recipient_id")
  activityId  String    @map("activity_id")
  tenantId    String    @map("tenant_id")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  recipient Profile  @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  activity  Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  tenant    Workspace @relation(fields: [tenantId], references: [id])

  @@unique([recipientId, activityId])
  @@index([recipientId, readAt, createdAt])
  @@index([tenantId])
  @@map("notifications")
}

model CommentMention {
  commentId String   @map("comment_id")
  profileId String   @map("profile_id")
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  profile Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tenant  Workspace @relation(fields: [tenantId], references: [id])

  @@id([commentId, profileId])
  @@index([profileId])
  @@index([tenantId])
  @@map("comment_mentions")
}

model PushSubscription {
  id        String   @id @default(uuid())
  profileId String   @map("profile_id")
  endpoint  String
  p256dh    String
  auth      String
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tenant  Workspace @relation(fields: [tenantId], references: [id])

  @@unique([endpoint])
  @@index([profileId])
  @@index([tenantId])
  @@map("push_subscriptions")
}

model SavedView {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  scope     String
  filters   Json
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Workspace @relation(fields: [tenantId], references: [id])

  @@unique([userId, scope, name])
  @@index([userId, scope])
  @@index([tenantId])
  @@map("saved_views")
}

model Document {
  id        String   @id @default(uuid())
  title     String
  content   String   @default("")
  projectId String?  @map("project_id")
  createdBy String   @map("created_by")
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project?  @relation(fields: [projectId], references: [id])
  creator Profile   @relation(fields: [createdBy], references: [id])
  tenant  Workspace @relation(fields: [tenantId], references: [id])

  @@index([projectId])
  @@index([createdBy])
  @@index([tenantId])
  @@map("documents")
}

model CalendarAuth {
  id           String    @id @default(uuid())
  userId       String    @unique @map("user_id")
  accessToken  String    @map("access_token")
  refreshToken String    @map("refresh_token")
  expiresAt    DateTime  @map("expires_at")
  googleEmail  String?   @map("google_email")
  lastSyncAt   DateTime? @map("last_sync_at")
  tenantId     String    @map("tenant_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user   Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Workspace @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("calendar_auth")
}

model CalendarEvent {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  taskId      String?   @map("task_id")
  areaId      String?   @map("area_id")
  googleId    String?   @map("google_id")
  etag        String?   @map("etag")
  title       String
  description String?
  startTime   DateTime  @map("start_time")
  endTime     DateTime  @map("end_time")
  allDay      Boolean   @default(false) @map("all_day")
  timeZone    String?   @map("time_zone")
  color       String?
  source      String    @default("google")
  syncedAt    DateTime? @map("synced_at")
  tenantId    String    @map("tenant_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user      Profile                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?                   @relation(fields: [taskId], references: [id])
  area      TeamArea?               @relation(fields: [areaId], references: [id], onDelete: SetNull)
  tenant    Workspace               @relation(fields: [tenantId], references: [id])
  attendees CalendarEventAttendee[]

  @@index([userId, startTime])
  @@index([taskId])
  @@index([areaId])
  @@index([tenantId])
  @@map("calendar_events")
}

model CalendarEventAttendee {
  id             String   @id @default(uuid())
  eventId        String   @map("event_id")
  profileId      String?  @map("profile_id")
  email          String
  displayName    String?  @map("display_name")
  responseStatus String   @default("needsAction") @map("response_status")
  organizer      Boolean  @default(false)
  tenantId       String   @map("tenant_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  profile Profile?      @relation(fields: [profileId], references: [id], onDelete: SetNull)
  tenant  Workspace     @relation(fields: [tenantId], references: [id])

  @@unique([eventId, email])
  @@index([profileId])
  @@index([tenantId])
  @@map("calendar_event_attendees")
}

model Client {
  id        String   @id @default(uuid())
  name      String
  legalName String?  @map("legal_name")
  cpfCnpj   String?  @map("cpf_cnpj")
  email     String?
  phone     String?
  notes     String?
  active    Boolean  @default(true)
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contracts Contract[]
  proposals Proposal[]
  tenant    Workspace @relation(fields: [tenantId], references: [id])

  @@unique([cpfCnpj])
  @@index([active])
  @@index([tenantId])
  @@map("clients")
}

model Contract {
  id               String   @id @default(uuid())
  code             String   @unique
  title            String?
  clientId         String?  @map("client_id")
  ownerId          String?  @map("owner_id")
  status           String   @default("draft")
  durationType     String?  @map("duration_type")
  officialValue    Decimal? @map("official_value") @db.Decimal(14, 2)
  startDate        String?  @map("start_date")
  endDate          String?  @map("end_date")
  billingFrequency String?  @map("billing_frequency")
  paymentMethod    String   @default("pix") @map("payment_method")
  documentUrl      String?  @map("document_url")
  notes            String?
  predecessorId    String?  @map("predecessor_id")
  tenantId         String   @map("tenant_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  client       Client?           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  owner        Profile?          @relation("ContractOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tenant       Workspace         @relation(fields: [tenantId], references: [id])
  items        ContractItem[]
  projects     ContractProject[]
  installments Installment[]
  changes      ContractChange[]
  audits       ContractAudit[]
  predecessor  Contract?         @relation("ContractRenewal", fields: [predecessorId], references: [id], onDelete: SetNull)
  successors   Contract[]        @relation("ContractRenewal")

  @@index([clientId])
  @@index([status])
  @@index([startDate])
  @@index([tenantId])
  @@map("contracts")
}

model ContractItem {
  id          String   @id @default(uuid())
  contractId  String   @map("contract_id")
  name        String
  description String?
  quantity    Decimal? @db.Decimal(14, 4)
  unit        String?
  price       Decimal? @db.Decimal(14, 2)
  position    Int      @default(0)
  tenantId    String   @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  contract Contract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  tenant   Workspace  @relation(fields: [tenantId], references: [id])

  @@index([contractId])
  @@index([tenantId])
  @@map("contract_items")
}

model ContractProject {
  contractId String @map("contract_id")
  projectId  String @map("project_id")
  tenantId   String @map("tenant_id")

  contract Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant   Workspace @relation(fields: [tenantId], references: [id])

  @@id([contractId, projectId])
  @@index([projectId])
  @@index([tenantId])
  @@map("contract_projects")
}

model Installment {
  id             String   @id @default(uuid())
  contractId     String   @map("contract_id")
  expectedAmount Decimal  @map("expected_amount") @db.Decimal(14, 2)
  dueDate        String   @map("due_date")
  paymentMethod  String   @default("pix") @map("payment_method")
  status         String   @default("pending")
  paidAt         String?  @map("paid_at")
  refundOfId     String?  @map("refund_of_id")
  cycleKey       String?  @map("cycle_key")
  tenantId       String   @map("tenant_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  contract Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  refundOf Installment?  @relation("InstallmentRefund", fields: [refundOfId], references: [id], onDelete: SetNull)
  refunds  Installment[] @relation("InstallmentRefund")
  tenant   Workspace     @relation(fields: [tenantId], references: [id])

  @@unique([contractId, cycleKey])
  @@index([contractId, status])
  @@index([dueDate])
  @@index([refundOfId])
  @@index([tenantId])
  @@map("installments")
}

model ContractChange {
  id            String   @id @default(uuid())
  contractId    String   @map("contract_id")
  type          String
  delta         Decimal  @db.Decimal(14, 2)
  effectiveDate String   @map("effective_date")
  description   String?
  previousValue Decimal  @map("previous_value") @db.Decimal(14, 2)
  newValue      Decimal  @map("new_value") @db.Decimal(14, 2)
  reason        String?
  actorId       String   @map("actor_id")
  tenantId      String   @map("tenant_id")
  createdAt     DateTime @default(now()) @map("created_at")

  contract Contract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  actor    Profile    @relation("ContractChangeActor", fields: [actorId], references: [id], onDelete: Restrict)
  tenant   Workspace  @relation(fields: [tenantId], references: [id])

  @@index([contractId, effectiveDate])
  @@index([tenantId])
  @@map("contract_changes")
}

model ContractAudit {
  id          String   @id @default(uuid())
  contractId  String   @map("contract_id")
  actorId     String?  @map("actor_id")
  field       String
  beforeValue Json?    @map("before_value")
  afterValue  Json?    @map("after_value")
  reason      String?
  tenantId    String   @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")

  contract Contract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  actor    Profile?   @relation("ContractAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  tenant   Workspace  @relation(fields: [tenantId], references: [id])

  @@index([contractId, createdAt])
  @@index([tenantId])
  @@map("contract_audits")
}

model ProposalTemplate {
  id        String   @id @default(uuid())
  name      String
  html      String   @default("")
  createdBy String   @map("created_by")
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator   Profile    @relation("ProposalTemplateCreator", fields: [createdBy], references: [id])
  tenant    Workspace  @relation(fields: [tenantId], references: [id])
  proposals Proposal[]

  @@index([createdBy])
  @@index([tenantId])
  @@map("proposal_templates")
}

model Proposal {
  id             String   @id @default(uuid())
  code           String   @unique
  token          String   @unique
  publicSlug     String   @unique @map("public_slug")
  title          String
  clientId       String   @map("client_id")
  templateId     String?  @map("template_id")
  createdBy      String   @map("created_by")
  status         String   @default("draft")
  htmlSnapshot   String   @map("html_snapshot") @default("")
  variables      Json     @default("{}")
  totalValue     Decimal? @map("total_value") @db.Decimal(14, 2)
  issueDate      String?  @map("issue_date")
  validUntil     String?  @map("valid_until")
  locale         String   @default("pt-BR")
  viewedAt       String?  @map("viewed_at")
  acceptedAt     String?  @map("accepted_at")
  acceptedByName String?  @map("accepted_by_name")
  rejectedAt     String?  @map("rejected_at")
  rejectedReason String?  @map("rejected_reason")
  tenantId       String   @map("tenant_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  client   Client?           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  template ProposalTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  creator  Profile           @relation("ProposalCreator", fields: [createdBy], references: [id])
  tenant   Workspace         @relation(fields: [tenantId], references: [id])
  items    ProposalItem[]

  @@index([clientId])
  @@index([createdBy])
  @@index([status])
  @@index([tenantId])
  @@map("proposals")
}

model ProposalItem {
  id          String   @id @default(uuid())
  proposalId  String   @map("proposal_id")
  name        String
  description String?
  quantity    Decimal? @db.Decimal(14, 4)
  price       Decimal? @db.Decimal(14, 2)
  position    Int      @default(0)
  tenantId    String   @map("tenant_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  proposal Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  tenant   Workspace @relation(fields: [tenantId], references: [id])

  @@index([proposalId])
  @@index([tenantId])
  @@map("proposal_items")
}

model WorkspaceSettings {
  id            String   @id @default("default")
  companyName   String?  @map("company_name")
  logoUrl       String?  @map("logo_url")
  defaultRoleId String?  @map("default_role_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  defaultRole Role? @relation(fields: [defaultRoleId], references: [id], onDelete: SetNull)

  @@map("workspace_settings")
}