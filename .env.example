DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seorganize?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/seorganize?schema=public"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_TOKEN_ENCRYPTION_KEY=""
# Base64-encoded 32-byte key for encrypting AI provider API keys at rest
AI_SECRET_ENCRYPTION_KEY=""
# Optional OpenCode Zen base URL prefix; /v1 is appended by the provider adapter.
OPENCODE_API_BASE_URL="https://opencode.ai/zen"
# Optional OpenCode Go base URL prefix; /v1 is appended by the provider adapter.
OPENCODE_GO_API_BASE_URL="https://opencode.ai/zen/go"
# Set false/true to stop new AI Studio generations without changing templates.
AI_STUDIO_ENABLED="true"
# Emergency kill switch for new AI Studio generations; templates remain untouched.
AI_STUDIO_KILL_SWITCH="false"
# Secret used by the scheduled AI Studio retention endpoint.
CRON_SECRET=""
# Maximum AI Studio generation calls per workspace in a rolling hour.
AI_STUDIO_WORKSPACE_RATE_LIMIT="30"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Comma-separated emails that are allowed to access the /admin panel (super-admins)
SUPER_ADMIN_EMAIL=""
CHECKIN_REQUIRED="true"
